# TradingAgents（本地改造版）环境变量示例
# ============================================================================
# 用法：复制本文件为 `.env`，按需填写。
#     cp .env.example .env      # macOS / Linux
#     copy .env.example .env    # Windows
#
# ⚠️ `.env` **已被 .gitignore 忽略**，绝不会入库。
#     本文件（`.env.example`）**只放键名与说明，不放任何真实值**。
#
# ★ 本清单依据「项目自有代码实际读取的变量」逐一核对生成（21 个变量），
#   不含第三方库（langchain / anthropic / google-genai 等）自带的上百个变量。
# ============================================================================


# ---------------------------------------------------------------------------
# 一、核心流水线必需（本项目「采集 → 12 角色 → 渲染」链路）
# ---------------------------------------------------------------------------

# SEC EDGAR 用户标识 —— **必需**，否则抓取财报会 403。
# 格式：`你的名字 你的邮箱`（SEC 要求能联系到你）
# 代码位置：quant/edgar_fundamentals.py（默认值含 admin@example.com 占位符 ⇒ 会被拒绝）
SEC_USER_AGENT=

# westock CLI 路径（A 股 / 港股采集用）—— 可选。
# 不填时按「PATH → ~/.local/bin/westock(.exe)」顺序自动查找。
# 代码位置：wb_analysis/_westock.py
WESTOCK_BIN=


# ---------------------------------------------------------------------------
# 二、可选数据源（缺失时对应通道降级，会写入「数据缺口」而非报错）
# ---------------------------------------------------------------------------

# FRED API Key（美国宏观：10Y 国债 / 收益率曲线 / ERP）—— 建议填。
# 不填时：wb_analysis/erp_context.py 会抛 RuntimeError ⇒ 改读离线缓存
#         wb_analysis/_cache/erp_history_sp500.json
# 申请：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage API Key（备用行情源）—— 可选。
ALPHA_VANTAGE_API_KEY=


# ---------------------------------------------------------------------------
# 三、上游 CLI 相关（本项目**已弃用**其 LLM 自动链路，一般无需设置）
# ---------------------------------------------------------------------------
# 本项目不调用任何付费 LLM API；以下仅在你确实要跑上游 `cli/` 时才需要。

# 输出语言（默认 Chinese）
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# LLM provider（上游 CLI 用；本项目流水线不依赖）
# TRADINGAGENTS_LLM_PROVIDER=
# TRADINGAGENTS_QUICK_THINK_LLM=
# TRADINGAGENTS_DEEP_THINK_LLM=
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=
# TRADINGAGENTS_MAX_RISK_ROUNDS=
# TRADINGAGENTS_CACHE_DIR=
# TRADINGAGENTS_RESULTS_DIR=
# TRADINGAGENTS_MEMORY_LOG_PATH=
# TRADINGAGENTS_SKIP_ANNOUNCEMENTS=

# 各 provider 的 key（仅上游 CLI / 冒烟脚本用，本项目流水线不需要）
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AWS_REGION=
# AWS_DEFAULT_REGION=
# AWS_BEARER_TOKEN_BEDROCK=
# OLLAMA_BASE_URL=
